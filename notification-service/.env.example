NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

MONGO_URL=mongodb://tickets:secret@localhost:27017/notifications?authSource=admin

RABBITMQ_URL=amqp://tickets:secret@localhost:5672
RABBITMQ_QUEUE=notifications.events
RABBITMQ_PREFETCH=10

# Public key only. This service verifies tokens issued by tickets-backend and
# must not be able to mint one — that is why the system uses RS256 rather than
# a shared HS256 secret. See docs/contracts/auth-jwt.md.
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt-public.pem

# Mailpit in development (http://localhost:8025 for the inbox). Point these at
# a real host in production; nothing else changes.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=tickets@example.com
MAIL_FROM_NAME=Tickets

# Used to build order links in outgoing email.
APP_URL=http://localhost

EMAIL_FLUSH_INTERVAL_MS=10000
EMAIL_MAX_ATTEMPTS=6
