<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Warnings are failures. A nullability warning in a service that parses
         payloads written by another system is a NullReferenceException waiting
         for the first event with an optional field omitted. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Referenced by WebApplicationFactory in the test project, which needs
         the generated Program class to be visible. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.1.0" />
    <PackageReference Include="RabbitMQ.Client" Version="7.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Polly" Version="8.5.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Analytics.Tests" />
  </ItemGroup>

</Project>
