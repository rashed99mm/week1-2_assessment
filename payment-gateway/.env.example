APP_NAME=Ticket Payment Gateway
APP_HOST=127.0.0.1
APP_PORT=8001

# SQLite is fine for a local run. Deployments point this at the shared
# PostgreSQL instance and run `alembic upgrade head` before starting:
#   DATABASE_URL=postgresql+psycopg://payments:secret@postgres:5432/payments
DATABASE_URL=sqlite:///./payment_gateway.db

# Shared secret the caller must send as X-Gateway-Key.
#
# Empty disables the check, which is the default so a bare checkout and the
# test suite work without setup. Required in any deployment: this service
# creates payment records, so reaching it should take more than being on the
# same network. Must match PAYMENT_GATEWAY_KEY in tickets-backend.
GATEWAY_API_KEY=

# The mock approval rule: a charge is approved when the amount is at or below
# APPROVAL_LIMIT and the card token starts with APPROVED_CARD_PREFIX.
APPROVAL_LIMIT=1000.0
APPROVED_CARD_PREFIX=4242
