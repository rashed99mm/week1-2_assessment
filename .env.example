# Deployment configuration for docker compose.
#
#   cp .env.example .env
#   ./scripts/generate-secrets.sh     # fills in the values marked CHANGE ME
#   docker compose up -d --wait
#
# Only nginx publishes a port. Everything else is reachable by service name on
# the internal network, which is why there are no host ports to configure for
# Postgres, RabbitMQ, Mongo or the payment gateway.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Tickets

# Must match how the browser reaches the site, including the port if not 80.
# Cover-image URLs and pagination links are built from the incoming request,
# but console and queue contexts have no request and fall back to this.
APP_URL=http://localhost

HTTP_PORT=80
LOG_LEVEL=warning

# php artisan key:generate --show
APP_KEY=

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
POSTGRES_USER=tickets
POSTGRES_DB=tickets
POSTGRES_PASSWORD=          # CHANGE ME

MONGO_USER=tickets
MONGO_PASSWORD=             # CHANGE ME

# ---------------------------------------------------------------------------
# Message broker
# ---------------------------------------------------------------------------
RABBITMQ_USER=tickets
RABBITMQ_PASSWORD=          # CHANGE ME

# ---------------------------------------------------------------------------
# Service-to-service
# ---------------------------------------------------------------------------
# Shared between tickets-backend and the payment gateway. The gateway is not
# reachable from outside the internal network, but a compromised sibling
# container should still not be able to mint payment records.
GATEWAY_API_KEY=            # CHANGE ME

# JWT signing uses RS256, with the key pair in deploy/secrets/ mounted as
# docker secrets. Laravel holds both halves and signs; the notification and
# analytics services get the public key only, so neither can issue a token.
# Generated by scripts/generate-secrets.sh.

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Delivered to Mailpit, whose inbox is on http://localhost:8025. Point the
# SMTP_* variables in compose.yaml at a real host for production; nothing else
# needs to change.
MAIL_FROM_ADDRESS=tickets@example.com
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# How long a pending order holds its tickets before the sweeper reclaims them.
TICKETS_RESERVATION_MINUTES=15

# Serves the unversioned /api/* routes alongside /api/v1, with Deprecation
# headers. Off: both front-ends now target /api/v1 directly. Set true only if
# an older client still needs the unversioned paths.
LEGACY_API_ENABLED=false
