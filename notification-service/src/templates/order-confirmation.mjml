<mj-text font-size="18px" font-weight="700">Your tickets are reserved</mj-text>

<mj-text>Hi {{customerName}},</mj-text>

<mj-text>
  We're holding {{quantity}} ticket(s) for <strong>{{eventTitle}}</strong>.
  Order <strong>#{{orderId}}</strong>.
</mj-text>

<mj-table>
  <tr>
    <td style="padding:6px 0;">{{ticketTypeName}} &times; {{quantity}}</td>
    <td style="padding:6px 0;text-align:right;">{{money unitPrice currency}} each</td>
  </tr>
  <tr>
    <td style="padding:10px 0;border-top:1px solid #e4e7eb;font-weight:700;">Total</td>
    <td style="padding:10px 0;border-top:1px solid #e4e7eb;text-align:right;" class="total">
      {{money totalAmount currency}}
    </td>
  </tr>
</mj-table>

{{!--
  Block helpers must sit inside mj-raw. MJML discards text that appears
  directly between components, so a bare Handlebars conditional here is
  silently dropped and the block it guards renders unconditionally — which for
  this one would print "held until  (UTC)" whenever expiresAt is null.
--}}
<mj-raw>{{#if expiresAt}}</mj-raw>
<mj-text css-class="muted">
  This reservation is held until {{formatDate expiresAt}} (UTC). After that the
  tickets go back on sale.
</mj-text>
<mj-raw>{{/if}}</mj-raw>

<mj-text>Complete payment to confirm your order.</mj-text>
