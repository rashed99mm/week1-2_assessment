APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

AUTH_GUARD=api
JWT_TTL=60

# Token signing. Two other services (notification-service, analytics-service)
# verify tokens issued here — see docs/contracts/auth-jwt.md.
#
# RS256 is the deployed configuration: this service signs with the private key
# and the others verify with the public key only, so a compromise of either
# consumer cannot mint an admin token. Generate a pair with:
#
#   openssl genrsa -out storage/jwt/private.pem 2048
#   openssl rsa -in storage/jwt/private.pem -pubout -out storage/jwt/public.pem
#
# then point these at the files (the package accepts a `file://` path or the
# PEM contents inline). The private key is a deployment secret and must never
# be committed.
JWT_ALGO=RS256
JWT_PRIVATE_KEY=file://storage/jwt/private.pem
JWT_PUBLIC_KEY=file://storage/jwt/public.pem
JWT_PASSPHRASE=

# HS256 fallback for a throwaway local checkout, where a single generated
# secret is less setup than a key pair. Set JWT_ALGO=HS256 and run
# `php artisan jwt:secret` to populate this. Do not use it anywhere that the
# Node or .NET services also run: it would require handing them a key that can
# sign as well as verify.
JWT_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is required in every environment that runs real traffic: the
# order flow depends on SELECT ... FOR UPDATE, which SQLite ignores, and the
# domain-event relay uses FOR UPDATE SKIP LOCKED. `docker compose up -d
# postgres` provides a matching server.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tickets
DB_USERNAME=tickets
DB_PASSWORD=secret
DB_SCHEMA=public
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAYMENT_GATEWAY_URL=http://127.0.0.1:8001
# Shared secret the gateway checks on every charge/refund. Required in any
# deployment; leave empty locally to skip the header.
PAYMENT_GATEWAY_KEY=

# How long a pending order holds its tickets before the sweeper reclaims them.
TICKETS_RESERVATION_MINUTES=15

# Serve the unversioned /api/* routes alongside /api/v1 for the React portal.
# Switch off once the Angular CMS has replaced the portal's admin pages.
LEGACY_API_ENABLED=true

# Domain events. When BROKER_ENABLED is false the events are still written to
# the outbox table inside their originating transaction — only the relay to
# RabbitMQ is skipped — so a local checkout needs no broker.
# See docs/contracts/broker-topology.md.
BROKER_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=tickets
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=tickets.events
