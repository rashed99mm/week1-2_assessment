<mj-text font-size="18px" font-weight="700">Your refund is on its way</mj-text>

<mj-text>Hi {{customerName}},</mj-text>

<mj-text>
  We've refunded order <strong>#{{orderId}}</strong> for {{eventTitle}}.
</mj-text>

<mj-table>
  <tr>
    <td style="padding:6px 0;font-weight:700;">Refunded</td>
    <td style="padding:6px 0;text-align:right;" class="total">{{money refundedAmount currency}}</td>
  </tr>
  {{!--
    Safe unwrapped here: this is inside mj-table, whose children are raw HTML
    that MJML passes through untouched. Only text directly between mj-*
    components gets discarded.
  --}}
  {{#if reason}}
  <tr>
    <td style="padding:6px 0;" class="muted">Reason</td>
    <td style="padding:6px 0;text-align:right;" class="muted">{{reason}}</td>
  </tr>
  {{/if}}
  <tr>
    <td style="padding:6px 0;" class="muted">Reference</td>
    <td style="padding:6px 0;text-align:right;" class="muted">{{gatewayReference}}</td>
  </tr>
</mj-table>

<mj-text css-class="muted">
  Refunds usually reach your account within 5&ndash;10 working days, depending
  on your bank.
</mj-text>
